# Copy to .env.local and fill in what you have. Every value is optional in
# development: the site runs without any of them, with the feature that needs
# the key clearly switched off rather than half working.
#
# .env.local is gitignored. Never commit a real key.

# ── Storage ───────────────────────────────────────────────────────────────────
# Everything the running site writes — records, sessions, and the photographs
# Daysi uploads from the office — lives under this one directory, so a host
# needs exactly one persistent disk mounted at one path. Unset, it is `.data`
# beside the source, which is what development uses. In production it MUST
# point at a mounted volume: left at the default it sits inside the deployed
# bundle, and the next release replaces it along with everything she has done.
DATA_DIR=""

# The site's own address. Used for absolute links, the QR code, Stripe return
# URLs, sign-in links, and as an accepted origin on every form.
SITE_URL="http://localhost:3000"

# ── Accounts ──────────────────────────────────────────────────────────────────
# Signs the cart cookie. REQUIRED IN PRODUCTION — the app refuses to start
# signing with a fallback key, because a signing key everyone can read is not a
# signing key. Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# Daysi's own address. It does two jobs: requests are emailed here, and the
# account that signs in with it is the one that gets the office. There is no
# role to grant, so nobody can promote themselves.
OWNER_EMAIL="daysi@example.com"

# ── "Continue with Google" ───────────────────────────────────────────────────
# One OAuth client from Google Cloud console (APIs & Services → Credentials →
# OAuth client ID, type "Web application"). Authorized redirect URI:
#   <SITE_URL>/api/auth/google/callback
# Without these the button is not rendered and the emailed link is the way in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Card payments (Stripe) ────────────────────────────────────────────────────
# Without these, orders are still placed and settled in person, and the site
# says so. Card details never reach this application: Stripe Checkout hosts the
# card form on its own domain, and Apple Pay and Google Pay come with it.
STRIPE_SECRET_KEY=""

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or the
# webhook endpoint in the Stripe dashboard. Without it the webhook refuses
# every call, which is the safe default: nothing is marked paid on trust.
STRIPE_WEBHOOK_SECRET=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign-in links and request notifications both go through here. Without a key,
# development prints sign-in links to the server console; production refuses to
# print them rather than log a live credential.
RESEND_API_KEY=""
NOTIFICATION_FROM="Daysi Collection <no-reply@daysicollection.com>"
