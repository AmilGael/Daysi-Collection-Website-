# Copy to .env.local and fill in what you have. Every value is optional: the
# site runs without any of them, with the feature that needs the key switched
# off rather than half working.
#
# .env.local is gitignored. Never commit a real key.

# The site's own address. Used for absolute links, the QR code, Stripe return
# URLs, and the same-origin check on every form.
SITE_URL="http://localhost:3000"

# ── Card payments (Stripe) ────────────────────────────────────────────────────
# Without these, deposits and session fees are settled in person and the site
# says so. Card details never reach this application: Stripe Checkout hosts the
# card form on its own domain, and Apple Pay and Google Pay come with it.
#
# Use a test key (sk_test_…) until Daysi's account is verified.
STRIPE_SECRET_KEY=""

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or from
# the webhook endpoint in the Stripe dashboard. Without it the webhook refuses
# every call, which is the safe default: nothing gets marked paid on trust.
STRIPE_WEBHOOK_SECRET=""

# ── Notifications (Resend) ────────────────────────────────────────────────────
# Without these, requests are still saved and still visible at /inbox in
# development; only the email is skipped.
RESEND_API_KEY=""
OWNER_EMAIL="daysi@example.com"
NOTIFICATION_FROM="Daysi Collection <no-reply@daysicollection.com>"
