{
  "name": "daysi-collection",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual website and client workflow tools for Daysi Collection Inc.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "predeploy": "npm run audit && npm run typecheck && npm test",
    "deploy": "fly deploy -a daysicollectioninc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "18.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "postcss": "^8.5.25"
  }
}
